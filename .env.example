# Cascade configuration. Copy to .env and adjust, or export these variables.
# The app reads plain environment variables (uvicorn --env-file .env works too).

# Where the SQLite database and local storage live.
CASCADE_DATA_DIR=./data

# Long-lived random secret used to sign session and link tokens.
# Leave empty and Cascade will generate data/secret.key on first boot.
CASCADE_SECRET=

# Bootstrap admin account, created only when the users table is empty.
CASCADE_ADMIN_EMAIL=admin@example.com
CASCADE_ADMIN_PASSWORD=change-me-please

# HTTP listener (only used when running `python -m cascade`).
CASCADE_HOST=0.0.0.0
CASCADE_PORT=8000

# Set to 1 when running behind a reverse proxy so X-Forwarded-For is honoured.
CASCADE_TRUST_PROXY=0

# Mark cookies Secure (enable on HTTPS-only deployments).
CASCADE_COOKIE_SECURE=0

# Optional yt-dlp binary used to resolve awkward hosts (TeraBox, etc).
CASCADE_YTDLP=yt-dlp
