# Cascade configuration. Copy to .env and adjust, or export these variables.
# The app reads plain environment variables (uvicorn --env-file .env works too).

# Where the SQLite database and local storage live.
CASCADE_DATA_DIR=./data

# Long-lived random secret used to sign session and link tokens.
# Leave empty and Cascade will generate data/secret.key on first boot.
CASCADE_SECRET=

# Optional bootstrap admin, created only when the users table is empty.
# Leave both blank to create the first admin through /setup instead.
CASCADE_ADMIN_EMAIL=
CASCADE_ADMIN_PASSWORD=

# HTTP listener (only used when running `python -m cascade`).
CASCADE_HOST=0.0.0.0
CASCADE_PORT=8000

# Set to 1 when running behind a reverse proxy so X-Forwarded-For is honoured.
CASCADE_TRUST_PROXY=0

# Mark cookies Secure (enable on HTTPS-only deployments).
CASCADE_COOKIE_SECURE=0

# Optional browser sign-in for TeraBox. This opens Chromium on the machine
# running Cascade and requires the optional helper:
#   pip install -r requirements-browser.txt
#   python -m playwright install chromium
# Without it, paste the ndus=... cookie into the node manually.
CASCADE_BROWSER_LOGIN=1
CASCADE_BROWSER_LOGIN_TIMEOUT=600

# Optional yt-dlp binary used to resolve awkward hosts (TeraBox, etc).
CASCADE_YTDLP=yt-dlp

# Public origin used for OAuth callbacks (and generated links if no setting is saved).
# Example: https://cascade.example.com
CASCADE_PUBLIC_BASE_URL=

# Cloud-drive sign-in. Create OAuth apps with these callback URLs:
#   https://your-host/oauth/dropbox/callback
#   https://your-host/oauth/gdrive/callback
#   https://your-host/oauth/onedrive/callback
CASCADE_DROPBOX_CLIENT_ID=
CASCADE_DROPBOX_CLIENT_SECRET=
CASCADE_GOOGLE_CLIENT_ID=
CASCADE_GOOGLE_CLIENT_SECRET=
CASCADE_MICROSOFT_CLIENT_ID=
CASCADE_MICROSOFT_CLIENT_SECRET=
